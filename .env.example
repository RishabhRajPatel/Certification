# ─────────────────────────────────────────────────────────────
#  docker-compose secrets — copy to `.env` in this same directory
#  and fill in real values. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# JWT signing secret for the backend container. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# Password for the seeded SUPERADMIN account. Change this after first login
# regardless — this is only used to create the account if it doesn't exist.
SEED_ADMIN_PASSWORD=
