# ─────────────────────────────────────────────────────────────
#  Maayad backend — environment variables
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

APP_NAME="Maayad API"
ENV="development"          # development | production

# Database — SQLite for zero-config dev; switch to Postgres in prod:
DATABASE_URL="sqlite:///./maayad.db"
# DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/maayad"

# JWT signing secret — generate with:  openssl rand -hex 32
AUTH_SECRET="change-me-please-generate-a-long-random-secret"
ACCESS_TOKEN_EXPIRE_HOURS=8

# Public URL of the FRONTEND — used to build QR verification links.
APP_URL="http://localhost:3000"

# Allowed CORS origins (comma-separated) — the frontend origin(s).
CORS_ORIGINS="http://localhost:3000"

# Seed admin (created once by scripts/seed.py)
SEED_ADMIN_EMAIL="admin@maayad.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="System Administrator"
