# ─────────────────────────────────────────────────────────────
#  Maayad frontend (Next.js) — environment variables
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend (server-side calls + PDF proxy).
BACKEND_URL="http://localhost:8000"

# Public (browser-reachable) URL of the same backend — used to load
# uploaded template backgrounds (/media/...) directly in <img>/<embed>,
# which the Next.js server can't proxy for a drag-and-drop canvas.
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Public URL of THIS frontend (used for QR verify links display).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shown on the login screen branding (public, no auth required).
NEXT_PUBLIC_COMPANY_NAME="Maayad Infotech Pvt. Ltd."
